# Copy to .env and adjust. Everything has a sensible default, so this is optional.

# UI application under test
BASE_URL=https://www.saucedemo.com

# API under test (Restful-Booker)
API_BASE_URL=https://restful-booker.herokuapp.com

# Credentials for the API demo service (public, documented by the service)
API_USERNAME=admin
API_PASSWORD=password123

# Default password for every SauceDemo user
SAUCE_PASSWORD=secret_sauce

# Set to "true" to run browsers headed
HEADED=false
